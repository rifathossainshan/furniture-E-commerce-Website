<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS and canonical domain (toponefurnitures.com)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^toponefurnitures\.com$ [NC]
    RewriteRule ^(.*)$ https://www.toponefurnitures.com/$1 [L,R=301]

    # 2. Block direct web access to sensitive files and directories on Shared Hosting
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|\.planning) - [F,L,NC]

    # 3. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 4. Route static assets from public folder if requested without /public/ prefix
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # 5. Route all other requests to root index.php (Front Controller)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

